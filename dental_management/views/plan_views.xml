<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_plan_form" model="ir.ui.view">
        <field name="name">dental.treatment.plan.form</field>
        <field name="model">dental.treatment.plan</field>
        <field name="arch" type="xml">
            <form string="Treatment Plan">
                <header>
                    <button name="action_accept" type="object" string="Patient Accepted" class="btn-primary" invisible="state != 'proposed'"/>
                    <button name="action_start_treatment" type="object" string="Start Treatment" class="btn-primary" invisible="state != 'accepted'"/>
                    <button name="action_complete" type="object" string="Complete" invisible="state != 'in_progress'"/>
                    <button name="action_reject" type="object" string="Rejected" invisible="state not in ('proposed', 'accepted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="proposed,accepted,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="dentist_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="valid_until"/>
                            <field name="treatment_id" invisible="not treatment_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Planned Procedures" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="phase"/>
                                    <field name="procedure_id"/>
                                    <field name="tooth_number"/>
                                    <field name="surface"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="subtotal"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_dental_plan_list" model="ir.ui.view">
        <field name="name">dental.treatment.plan.list</field>
        <field name="model">dental.treatment.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="date"/><field name="patient_id"/><field name="dentist_id"/>
                <field name="amount_total" sum="Total"/><field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state in ('accepted', 'completed')" decoration-warning="state == 'in_progress'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>
    <record id="action_dental_plan" model="ir.actions.act_window">
        <field name="name">Treatment Plans</field>
        <field name="res_model">dental.treatment.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
