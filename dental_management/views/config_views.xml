<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Procedures -->
    <record id="view_dental_procedure_list" model="ir.ui.view">
        <field name="name">dental.procedure.list</field>
        <field name="model">dental.procedure</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="duration" widget="float_time"/>
                <field name="price"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_dental_procedure_search" model="ir.ui.view">
        <field name="name">dental.procedure.search</field>
        <field name="model">dental.procedure</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="code"/>
                <group><filter name="group_cat" string="Category" context="{'group_by': 'category'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_dental_procedure" model="ir.actions.act_window">
        <field name="name">Procedures</field>
        <field name="res_model">dental.procedure</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_cat': 1}</field>
    </record>

    <!-- Medicines -->
    <record id="view_dental_medicine_list" model="ir.ui.view">
        <field name="name">dental.medicine.list</field>
        <field name="model">dental.medicine</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/><field name="form"/><field name="strength"/>
                <field name="default_dosage"/><field name="notes"/>
            </list>
        </field>
    </record>
    <record id="action_dental_medicine" model="ir.actions.act_window">
        <field name="name">Medicines</field>
        <field name="res_model">dental.medicine</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Rooms -->
    <record id="view_dental_room_list" model="ir.ui.view">
        <field name="name">dental.room.list</field>
        <field name="model">dental.room</field>
        <field name="arch" type="xml">
            <list editable="bottom"><field name="name"/><field name="code"/></list>
        </field>
    </record>
    <record id="action_dental_room" model="ir.actions.act_window">
        <field name="name">Rooms / Chairs</field>
        <field name="res_model">dental.room</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Medical conditions -->
    <record id="view_dental_condition_list" model="ir.ui.view">
        <field name="name">dental.medical.condition.list</field>
        <field name="model">dental.medical.condition</field>
        <field name="arch" type="xml">
            <list editable="bottom"><field name="name"/><field name="color" widget="color_picker"/></list>
        </field>
    </record>
    <record id="action_dental_condition" model="ir.actions.act_window">
        <field name="name">Medical Conditions</field>
        <field name="res_model">dental.medical.condition</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
