<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_dental_treatment" model="ir.actions.report">
        <field name="name">Treatment Summary</field>
        <field name="model">dental.treatment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">dental_management.report_treatment_document</field>
        <field name="report_file">dental_management.report_treatment_document</field>
        <field name="print_report_name">'Treatment - %s' % object.name</field>
        <field name="binding_model_id" ref="model_dental_treatment"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_treatment_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Treatment Summary <small t-out="o.name"/></h2>
                        <div class="row mt-3 mb-3">
                            <div class="col-6">
                                <strong>Patient:</strong> <span t-out="o.patient_id.name"/><br/>
                                <strong>Patient ID:</strong> <span t-out="o.patient_id.code"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Dentist:</strong> Dr. <span t-out="o.dentist_id.name"/><br/>
                                <strong>Date:</strong> <span t-field="o.date"/>
                            </div>
                        </div>
                        <p t-if="o.diagnosis"><strong>Diagnosis:</strong> <span t-out="o.diagnosis"/></p>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr><th>Procedure</th><th>Tooth</th><th class="text-end">Qty</th>
                                    <th class="text-end">Unit Price</th><th class="text-end">Disc. %</th><th class="text-end">Subtotal</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="l">
                                    <td><span t-out="l.procedure_id.name"/></td>
                                    <td><span t-out="l.tooth_number"/></td>
                                    <td class="text-end"><span t-out="l.quantity"/></td>
                                    <td class="text-end"><span t-field="l.price_unit"/></td>
                                    <td class="text-end"><span t-out="l.discount"/></td>
                                    <td class="text-end"><span t-field="l.subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="text-end"><h4>Total: <span t-field="o.amount_total"/></h4></div>
                        <p t-if="o.notes"><strong>Notes:</strong> <span t-out="o.notes"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
