<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_appointment_confirm" model="mail.template">
        <field name="name">Dental: Appointment Confirmation</field>
        <field name="model_id" ref="model_dental_appointment"/>
        <field name="subject">Appointment confirmed {{ object.name }}</field>
        <field name="email_to">{{ object.patient_id.email }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;font-size:14px;">
    <p>Dear <t t-out="object.patient_id.name"/>,</p>
    <p>Your dental appointment is confirmed.</p>
    <ul>
        <li><b>Dentist:</b> Dr. <t t-out="object.dentist_id.name"/></li>
        <li><b>When:</b> <t t-out="format_datetime(object.start_datetime, dt_format='medium')"/></li>
        <li><b>Reference:</b> <t t-out="object.name"/></li>
    </ul>
    <p>Please arrive 10 minutes early. To reschedule, contact the clinic.</p>
    <p>Regards,<br/><t t-out="object.company_id.name"/></p>
</div>
        </field>
    </record>

    <record id="mail_template_appointment_reminder" model="mail.template">
        <field name="name">Dental: Appointment Reminder</field>
        <field name="model_id" ref="model_dental_appointment"/>
        <field name="subject">Reminder: dental appointment {{ object.name }}</field>
        <field name="email_to">{{ object.patient_id.email }}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;font-size:14px;">
    <p>Dear <t t-out="object.patient_id.name"/>,</p>
    <p>This is a reminder of your upcoming dental appointment with
       Dr. <t t-out="object.dentist_id.name"/> on
       <b><t t-out="format_datetime(object.start_datetime, dt_format='medium')"/></b>.</p>
    <p>We look forward to seeing you.<br/><t t-out="object.company_id.name"/></p>
</div>
        </field>
    </record>
</odoo>
