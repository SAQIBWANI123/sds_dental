<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_dental_patient" model="ir.sequence">
        <field name="name">Dental Patient</field><field name="code">dental.patient</field>
        <field name="prefix">PAT-</field><field name="padding">5</field>
    </record>
    <record id="seq_dental_appointment" model="ir.sequence">
        <field name="name">Dental Appointment</field><field name="code">dental.appointment</field>
        <field name="prefix">APT/%(year)s/</field><field name="padding">5</field>
    </record>
    <record id="seq_dental_treatment" model="ir.sequence">
        <field name="name">Dental Treatment</field><field name="code">dental.treatment</field>
        <field name="prefix">TRT/%(year)s/</field><field name="padding">5</field>
    </record>
    <record id="seq_dental_plan" model="ir.sequence">
        <field name="name">Dental Treatment Plan</field><field name="code">dental.treatment.plan</field>
        <field name="prefix">PLN/%(year)s/</field><field name="padding">5</field>
    </record>
    <record id="seq_dental_prescription" model="ir.sequence">
        <field name="name">Dental Prescription</field><field name="code">dental.prescription</field>
        <field name="prefix">RX/%(year)s/</field><field name="padding">5</field>
    </record>
    <record id="seq_dental_lab" model="ir.sequence">
        <field name="name">Dental Lab Order</field><field name="code">dental.lab.order</field>
        <field name="prefix">LAB/%(year)s/</field><field name="padding">5</field>
    </record>
</odoo>
