<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_dental_user" model="res.groups">
        <field name="name">Dental: Receptionist</field>
        <field name="comment">Registers patients, books appointments and prepares invoices.</field>
    </record>
    <record id="group_dental_dentist" model="res.groups">
        <field name="name">Dental: Dentist</field>
        <field name="implied_ids" eval="[(4, ref('group_dental_user'))]"/>
        <field name="comment">Records dental charts, treatments, prescriptions and lab orders.</field>
    </record>
    <record id="group_dental_manager" model="res.groups">
        <field name="name">Dental: Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_dental_dentist'))]"/>
        <field name="comment">Full access including configuration.</field>
    </record>

    <!-- Multi-company rules -->
    <record id="rule_dental_patient_company" model="ir.rule">
        <field name="name">Dental Patient: multi-company</field>
        <field name="model_id" ref="model_dental_patient"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dental_appointment_company" model="ir.rule">
        <field name="name">Dental Appointment: multi-company</field>
        <field name="model_id" ref="model_dental_appointment"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dental_treatment_company" model="ir.rule">
        <field name="name">Dental Treatment: multi-company</field>
        <field name="model_id" ref="model_dental_treatment"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
