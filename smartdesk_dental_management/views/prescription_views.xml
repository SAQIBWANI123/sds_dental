<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_prescription_form" model="ir.ui.view">
        <field name="name">dental.prescription.form</field>
        <field name="model">dental.prescription</field>
        <field name="arch" type="xml">
            <form string="Prescription">
                <header>
                    <button name="%(action_report_dental_prescription)d" type="action" string="Print" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="dentist_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="diagnosis"/>
                            <field name="treatment_id" domain="[('patient_id', '=', patient_id)]"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Medicines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="medicine_id"/>
                                    <field name="dosage"/>
                                    <field name="frequency"/>
                                    <field name="duration_days"/>
                                    <field name="timing"/>
                                    <field name="instructions"/>
                                </list>
                            </field>
                        </page>
                        <page string="Advice" name="notes"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_dental_prescription_list" model="ir.ui.view">
        <field name="name">dental.prescription.list</field>
        <field name="model">dental.prescription</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="date"/><field name="patient_id"/>
                <field name="dentist_id"/><field name="diagnosis"/>
            </list>
        </field>
    </record>
    <record id="action_dental_prescription" model="ir.actions.act_window">
        <field name="name">Prescriptions</field>
        <field name="res_model">dental.prescription</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
