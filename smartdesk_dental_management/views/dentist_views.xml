<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_dentist_list" model="ir.ui.view">
        <field name="name">dental.dentist.list</field>
        <field name="model">dental.dentist</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="specialization"/>
                <field name="license_no"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="consultation_fee"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dental_dentist_form" model="ir.ui.view">
        <field name="name">dental.dentist.form</field>
        <field name="model">dental.dentist</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appointments" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="Appointments"/>
                        </button>
                        <button name="action_view_appointments" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="patient_count" widget="statinfo" string="Patients"/>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <field name="active" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Dr. Full Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="specialization"/>
                            <field name="license_no"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="consultation_fee"/>
                            <field name="color" widget="color_picker"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Biography, qualifications, schedule notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dental_dentist_search" model="ir.ui.view">
        <field name="name">dental.dentist.search</field>
        <field name="model">dental.dentist</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="license_no"/>
                <field name="specialization"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_spec" string="Specialization" context="{'group_by': 'specialization'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dental_dentist" model="ir.actions.act_window">
        <field name="name">Dentists</field>
        <field name="res_model">dental.dentist</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
