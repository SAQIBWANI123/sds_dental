<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dental chart entries -->
    <record id="view_dental_tooth_line_list" model="ir.ui.view">
        <field name="name">dental.tooth.line.list</field>
        <field name="model">dental.tooth.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="date"/><field name="patient_id"/><field name="tooth_number"/>
                <field name="surface"/><field name="condition"/><field name="dentist_id"/><field name="notes"/>
            </list>
        </field>
    </record>
    <record id="view_dental_tooth_line_pivot" model="ir.ui.view">
        <field name="name">dental.tooth.line.pivot</field>
        <field name="model">dental.tooth.line</field>
        <field name="arch" type="xml">
            <pivot><field name="condition" type="row"/><field name="tooth_number" type="col"/></pivot>
        </field>
    </record>
    <record id="action_dental_tooth_line" model="ir.actions.act_window">
        <field name="name">Dental Chart Entries</field>
        <field name="res_model">dental.tooth.line</field>
        <field name="view_mode">list,pivot</field>
    </record>

    <!-- X-rays -->
    <record id="view_dental_xray_form" model="ir.ui.view">
        <field name="name">dental.xray.form</field>
        <field name="model">dental.xray</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/><field name="patient_id"/><field name="dentist_id"/>
                        </group>
                        <group>
                            <field name="date"/><field name="xray_type"/><field name="tooth_number"/>
                        </group>
                    </group>
                    <field name="image" widget="image" options="{'size': [0, 480]}"/>
                    <field name="notes" placeholder="Findings..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_dental_xray_list" model="ir.ui.view">
        <field name="name">dental.xray.list</field>
        <field name="model">dental.xray</field>
        <field name="arch" type="xml">
            <list><field name="date"/><field name="name"/><field name="patient_id"/><field name="xray_type"/><field name="tooth_number"/><field name="dentist_id"/></list>
        </field>
    </record>
    <record id="action_dental_xray" model="ir.actions.act_window">
        <field name="name">X-Rays &amp; Images</field>
        <field name="res_model">dental.xray</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Lab orders -->
    <record id="view_dental_lab_form" model="ir.ui.view">
        <field name="name">dental.lab.order.form</field>
        <field name="model">dental.lab.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" type="object" string="Send to Lab" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_receive" type="object" string="Mark Received" class="btn-primary" invisible="state != 'sent'"/>
                    <button name="action_fit" type="object" string="Mark Fitted" invisible="state != 'received'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('fitted', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,received,fitted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="patient_id"/><field name="dentist_id"/>
                            <field name="lab_id"/><field name="work_type"/>
                            <field name="tooth_number"/><field name="shade"/>
                        </group>
                        <group>
                            <field name="sent_date"/><field name="due_date"/>
                            <field name="received_date"/><field name="cost"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Instructions for the lab..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_dental_lab_list" model="ir.ui.view">
        <field name="name">dental.lab.order.list</field>
        <field name="model">dental.lab.order</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'sent' and due_date and due_date &lt; context_today().strftime('%Y-%m-%d')">
                <field name="name"/><field name="patient_id"/><field name="dentist_id"/>
                <field name="work_type"/><field name="tooth_number"/><field name="due_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="action_dental_lab" model="ir.actions.act_window">
        <field name="name">Lab Orders</field>
        <field name="res_model">dental.lab.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
