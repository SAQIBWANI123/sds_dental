<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_appointment_form" model="ir.ui.view">
        <field name="name">dental.appointment.form</field>
        <field name="model">dental.appointment</field>
        <field name="arch" type="xml">
            <form string="Appointment">
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_check_in" type="object" string="Check In" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'checked_in'"/>
                    <button name="action_create_treatment" type="object" string="Create Treatment" invisible="state not in ('checked_in', 'in_progress', 'done')"/>
                    <button name="action_done" type="object" string="Mark Done" invisible="state not in ('in_progress', 'checked_in')"/>
                    <button name="action_no_show" type="object" string="No Show" invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset" type="object" string="Set to Draft" invisible="state not in ('cancelled', 'no_show')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,checked_in,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_treatments" type="object" class="oe_stat_button" icon="fa-stethoscope" invisible="treatment_count == 0">
                            <field name="treatment_count" widget="statinfo" string="Treatments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="dentist_id"/>
                            <field name="room_id"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="duration" widget="float_time"/>
                            <field name="end_datetime"/>
                            <field name="reason"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Planned Procedures" name="procedures">
                            <field name="procedure_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Notes" name="notes"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dental_appointment_list" model="ir.ui.view">
        <field name="name">dental.appointment.list</field>
        <field name="model">dental.appointment</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('cancelled', 'no_show')" decoration-success="state == 'done'" decoration-info="state == 'confirmed'">
                <field name="name"/>
                <field name="start_datetime"/>
                <field name="patient_id"/>
                <field name="dentist_id"/>
                <field name="room_id" optional="show"/>
                <field name="reason" optional="show"/>
                <field name="priority" widget="priority" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state in ('confirmed', 'checked_in')" decoration-warning="state == 'in_progress'" decoration-danger="state in ('cancelled', 'no_show')"/>
            </list>
        </field>
    </record>

    <record id="view_dental_appointment_calendar" model="ir.ui.view">
        <field name="name">dental.appointment.calendar</field>
        <field name="model">dental.appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments" date_start="start_datetime" date_stop="end_datetime" color="dentist_id" mode="week" quick_create="0">
                <field name="patient_id"/>
                <field name="dentist_id"/>
                <field name="reason"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_dental_appointment_kanban" model="ir.ui.view">
        <field name="name">dental.appointment.kanban</field>
        <field name="model">dental.appointment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" group_create="false" records_draggable="0">
                <templates>
                    <t t-name="card">
                        <field name="patient_id" class="fw-bold"/>
                        <div class="text-muted"><field name="start_datetime"/></div>
                        <div>Dr. <field name="dentist_id"/></div>
                        <field name="reason" class="text-muted"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dental_appointment_graph" model="ir.ui.view">
        <field name="name">dental.appointment.graph</field>
        <field name="model">dental.appointment</field>
        <field name="arch" type="xml">
            <graph string="Appointments" type="bar">
                <field name="start_datetime" interval="week"/>
                <field name="dentist_id"/>
            </graph>
        </field>
    </record>

    <record id="view_dental_appointment_pivot" model="ir.ui.view">
        <field name="name">dental.appointment.pivot</field>
        <field name="model">dental.appointment</field>
        <field name="arch" type="xml">
            <pivot string="Appointments">
                <field name="dentist_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_dental_appointment_search" model="ir.ui.view">
        <field name="name">dental.appointment.search</field>
        <field name="model">dental.appointment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="dentist_id"/>
                <filter name="today" string="Today" domain="[('start_datetime', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0, 0, 0))), ('start_datetime', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23, 59, 59)))]"/>
                <filter name="upcoming" string="Upcoming" domain="[('state', 'in', ('draft', 'confirmed')), ('start_datetime', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="f_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="f_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="f_done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="f_urgent" string="Urgent" domain="[('priority', '=', '1')]"/>
                <group>
                    <filter name="group_dentist" string="Dentist" context="{'group_by': 'dentist_id'}"/>
                    <filter name="group_patient" string="Patient" context="{'group_by': 'patient_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'start_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dental_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">dental.appointment</field>
        <field name="view_mode">calendar,list,kanban,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Book the first appointment</p>
            <p>Schedule patients with dentists and rooms. Conflicts are detected automatically.</p>
        </field>
    </record>
</odoo>
