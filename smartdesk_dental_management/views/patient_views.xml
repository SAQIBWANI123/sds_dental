<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dental_patient_form" model="ir.ui.view">
        <field name="name">dental.patient.form</field>
        <field name="model">dental.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <header>
                    <button name="action_new_appointment" type="object" string="Book Appointment" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appointments" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="Appointments"/>
                        </button>
                        <button name="action_view_treatments" type="object" class="oe_stat_button" icon="fa-stethoscope">
                            <field name="treatment_count" widget="statinfo" string="Treatments"/>
                        </button>
                        <button name="action_view_prescriptions" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="prescription_count" widget="statinfo" string="Prescriptions"/>
                        </button>
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Patient full name"/></h1>
                        <h3><field name="code"/></h3>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not allergies">
                        <strong>Allergy alert:</strong> <field name="allergies" readonly="1" nolabel="1" class="d-inline"/>
                    </div>
                    <group>
                        <group string="Personal">
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="blood_group"/>
                            <field name="occupation"/>
                            <field name="preferred_dentist_id"/>
                        </group>
                        <group string="Contact">
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="emergency_name"/>
                            <field name="emergency_phone"/>
                            <field name="partner_id" groups="base.group_no_one"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dental Chart" name="chart">
                            <field name="chart_html" widget="html" readonly="1" nolabel="1"/>
                            <field name="tooth_line_ids" context="{'default_patient_id': id}">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="tooth_number"/>
                                    <field name="surface"/>
                                    <field name="condition"/>
                                    <field name="dentist_id"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Medical History" name="medical">
                            <group>
                                <group>
                                    <field name="allergies"/>
                                    <field name="condition_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    <field name="current_medication"/>
                                </group>
                                <group>
                                    <field name="has_diabetes"/>
                                    <field name="has_hypertension"/>
                                    <field name="is_smoker"/>
                                    <field name="is_pregnant" invisible="gender != 'female'"/>
                                    <field name="medical_notes"/>
                                </group>
                            </group>
                        </page>
                        <page string="Insurance" name="insurance">
                            <group>
                                <field name="insurance_provider"/>
                                <field name="insurance_number"/>
                            </group>
                        </page>
                        <page string="Appointments" name="appointments">
                            <field name="appointment_ids" readonly="1">
                                <list>
                                    <field name="name"/><field name="start_datetime"/>
                                    <field name="dentist_id"/><field name="reason"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Treatments" name="treatments">
                            <field name="treatment_ids" readonly="1">
                                <list>
                                    <field name="name"/><field name="date"/><field name="dentist_id"/>
                                    <field name="amount_total"/><field name="state" widget="badge"/>
                                    <field name="payment_state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Plans" name="plans">
                            <field name="plan_ids" readonly="1">
                                <list>
                                    <field name="name"/><field name="date"/><field name="dentist_id"/>
                                    <field name="amount_total"/><field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="X-Rays &amp; Images" name="xrays">
                            <field name="xray_ids">
                                <list>
                                    <field name="date"/><field name="name"/><field name="xray_type"/>
                                    <field name="tooth_number"/><field name="dentist_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Lab Orders" name="labs">
                            <field name="lab_order_ids" readonly="1">
                                <list>
                                    <field name="name"/><field name="work_type"/><field name="tooth_number"/>
                                    <field name="due_date"/><field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dental_patient_list" model="ir.ui.view">
        <field name="name">dental.patient.list</field>
        <field name="model">dental.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="preferred_dentist_id"/>
                <field name="last_visit"/>
            </list>
        </field>
    </record>

    <record id="view_dental_patient_kanban" model="ir.ui.view">
        <field name="name">dental.patient.kanban</field>
        <field name="model">dental.patient</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="image_128"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <div class="me-3">
                                <img t-att-src="kanban_image('dental.patient', 'image_128', record.id.raw_value)"
                                     class="rounded" style="width:64px;height:64px;object-fit:cover;" alt="Patient"/>
                            </div>
                            <div class="flex-grow-1">
                                <field name="name" class="fw-bold fs-5"/>
                                <div class="text-muted"><field name="code"/></div>
                                <div><field name="phone"/></div>
                                <div class="text-muted"><field name="preferred_dentist_id"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dental_patient_search" model="ir.ui.view">
        <field name="name">dental.patient.search</field>
        <field name="model">dental.patient</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('code', 'ilike', self), ('phone', 'ilike', self)]"/>
                <field name="email"/>
                <field name="preferred_dentist_id"/>
                <filter name="male" string="Male" domain="[('gender', '=', 'male')]"/>
                <filter name="female" string="Female" domain="[('gender', '=', 'female')]"/>
                <filter name="has_allergy" string="Has Allergies" domain="[('allergies', '!=', False)]"/>
                <filter name="diabetic" string="Diabetic" domain="[('has_diabetes', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_dentist" string="Preferred Dentist" context="{'group_by': 'preferred_dentist_id'}"/>
                    <filter name="group_gender" string="Gender" context="{'group_by': 'gender'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dental_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">dental.patient</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first patient</p>
            <p>Keep medical history, dental chart, treatments and invoices in one place.</p>
        </field>
    </record>
</odoo>
